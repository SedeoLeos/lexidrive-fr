{
  "name": "lexidrive-fr",
  "version": "1.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo run:android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx tests/domain.test.ts",
    "test:e2e": "playwright test",
    "export:web": "expo export --platform web",
    "export:mobile": "expo export --platform android --platform ios",
    "export:all": "expo export --platform all",
    "format": "prettier --write App.tsx index.ts src tests *.js *.json *.ts",
    "apk": "cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "expo": "~57.0.26",
    "expo-audio": "~57.0.5",
    "expo-file-system": "~57.0.7",
    "expo-sharing": "~57.0.22",
    "expo-font": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "@expo/metro-runtime": "~57.0.16",
    "@react-native-async-storage/async-storage": "2.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-web": "~0.21.0",
    "nativewind": "4.2.6",
    "react-native-css-interop": "0.2.6",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "lucide-react-native": "^1.47.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3",
    "babel-preset-expo": "~57.0.12",
    "tailwindcss": "3.4.19",
    "@playwright/test": "^1.63.0",
    "tsx": "^4.23.0",
    "@types/node": "^22.0.0",
    "prettier": "^3.9.8"
  },
  "packageManager": "pnpm@10.17.1+sha512.17c560fca4867ae9473a3899ad84a88334914f379be46d455cbf92e5cf4b39d34985d452d2583baf19967fa76cb5c17bc9e245529d0b98745721aa7200ecaf7a"
}
